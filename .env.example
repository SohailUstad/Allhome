# Settings read by chat-service (and DB_PORT by compose.yaml). Copy to .env and fill in for your environment.
# Every value except OPENAI_API_KEY and OPERATOR_PASSWORD has a local default matching compose.yaml.
# Never commit .env: it is git-ignored.

# OpenAI API key, used for embeddings and chat replies. Required to ingest knowledge and to chat; the app starts without it.
OPENAI_API_KEY=
# Chat model (default gpt-4.1-mini)
OPENAI_CHAT_MODEL=gpt-4.1-mini

# Zoho SalesIQ webhook: public key(s) from SalesIQ > Zobot > Webhook > "Secure your webhook" (empty = not checked,
# local testing only), and an optional department for chats forwarded to operators.
SALESIQ_PUBLIC_KEYS=
SALESIQ_DEPARTMENT_ID=
# SalesIQ widget embed code shown on the demo website (default: the prototype's widget)
SALESIQ_WIDGET_CODE=

# Operator login (HTTP Basic) for /api/ingestions. Without a password nobody can log in.
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=

# Database (chat-service)
DB_URL=jdbc:postgresql://localhost:5433/chat
DB_USERNAME=chat
DB_PASSWORD=chat

# Host port published by compose.yaml for PostgreSQL
DB_PORT=5433

# HTTP port of chat-service
SERVER_PORT=8080
