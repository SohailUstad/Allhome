# Settings read by chat-service (and DB_PORT by compose.yaml). Copy to .env and fill in for your environment.
# Every value except OPENAI_API_KEY and OPERATOR_PASSWORD has a local default matching compose.yaml.
# Never commit .env: it is git-ignored.

# OpenAI API key, used for embeddings (text-embedding-3-small). Required to ingest knowledge; the app starts without it.
OPENAI_API_KEY=

# Operator login (HTTP Basic) for /api/ingestions. Without a password nobody can log in.
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=

# Database (chat-service)
DB_URL=jdbc:postgresql://localhost:5433/chat
DB_USERNAME=chat
DB_PASSWORD=chat

# Host port published by compose.yaml for PostgreSQL
DB_PORT=5433

# HTTP port of chat-service
SERVER_PORT=8080
